---
layout: default
---
<div class="post">
  <header class="post-header home-intro">
    <div class="home-intro-text">
      <a class="institution-logo" href="https://www.rice.edu/" aria-label="Rice University">
        <img src="{{ '/assets/img/rice-logo.png' | relative_url }}" alt="Rice University" width="1280" height="800" decoding="async">
      </a>
      <h1 class="post-title">
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      </h1>
      <p class="desc">{{ page.subtitle }}</p>
    </div>
    <img
      class="home-portrait"
      src="{{ page.profile.image | prepend: '/assets/img/' | relative_url | bust_file_cache }}"
      alt="{{ page.profile.alt }}"
      width="320"
      height="380"
      decoding="async"
    >
  </header>
  <article>
    <div class="clearfix">{{ content }}</div>
  </article>
</div>
